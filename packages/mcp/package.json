{
  "name": "@jmrojas06/agentsprint-mcp",
  "version": "0.1.0",
  "description": "MCP server so AI coding agents can read, claim and complete AgentSprint tasks",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "keywords": ["mcp", "model-context-protocol", "ai-agents", "sprint", "kanban"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrojas06/AgentSprint.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/jmrojas06/AgentSprint/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentboard-mcp": "./dist/index.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jmrojas06/agentsprint-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
