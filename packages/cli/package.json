{
  "name": "@agentsprint/cli",
  "version": "0.1.0",
  "description": "AgentSprint command-line tool",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentboard": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentsprint/core": "workspace:*",
    "@agentsprint/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
