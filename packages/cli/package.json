{
  "name": "@jmrojas06/agentsprint-cli",
  "version": "0.1.0",
  "description": "AgentSprint command-line tool — git-native sprint board for coding with AI agents",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "keywords": ["cli", "agents", "sprint", "kanban", "board", "ai-coding", "mcp"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrojas06/AgentSprint.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/jmrojas06/AgentSprint/issues"
  },
  "bin": {
    "agentboard": "./dist/index.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jmrojas06/agentsprint-core": "workspace:*",
    "@jmrojas06/agentsprint-server": "workspace:*",
    "@jmrojas06/agentsprint-web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
