{
  "name": "@agentsprint/core",
  "version": "0.1.0",
  "description": "Domain model and git-native file storage for AgentSprint",
  "license": "MIT",
  "type": "module",
  "keywords": ["agents", "sprint", "kanban", "board", "markdown", "git-native", "ai-coding"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentsprint/agentsprint.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/agentsprint/agentsprint/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
