{
  "name": "@jmrojas06/agentsprint-server",
  "version": "0.1.0",
  "description": "REST + SSE + file-watcher server for AgentSprint",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "keywords": ["agents", "sprint", "kanban", "fastify", "sse", "server"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmrojas06/AgentSprint.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/jmrojas06/AgentSprint/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jmrojas06/agentsprint-core": "workspace:*",
    "@jmrojas06/agentsprint-mcp": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
