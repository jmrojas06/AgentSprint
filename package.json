{
  "name": "agentsprint",
  "version": "0.1.0",
  "private": true,
  "description": "Git-native sprint board for solo developers who code with AI agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "agentsprint": "pnpm --filter @agentsprint/cli start"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
