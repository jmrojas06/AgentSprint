{
  "name": "agentsprint",
  "version": "0.1.0",
  "private": true,
  "description": "Git-native sprint board for solo developers who code with AI agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "agentsprint": "pnpm --filter @jmrojas06/agentsprint-cli start",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitepress": "^1.6.3"
  }
}
